"""Versioned client-composition contract for StoreMesh."""
schema { query: Query, mutation: Mutation }

type Query {
  """Catalog data combined with the fields needed by storefront screens."""
  products(pageSize: Int, pageToken: String, status: ProductStatus): ProductConnection!
  """The authenticated customer's persisted cart."""
  cart: Cart!
  """The authenticated customer's paginated order history."""
  orders(pageSize: Int, pageToken: String, status: OrderStatus): OrderConnection!
}

type Mutation {
  """Replace the authenticated customer's persisted cart."""
  updateCart(lines: [CartLineInput!]!): Cart!
  """Clear the authenticated customer's persisted cart."""
  clearCart: Cart!
  """Create an order from the authenticated customer's cart lines."""
  createOrder(lines: [OrderLineInput!]!, idempotencyKey: String!): Order!
}

type ProductConnection {
  products: [Product!]!
  nextPageToken: String
}

type Product {
  id: ID!
  sku: String!
  name: String!
  description: String!
  priceMinor: Int!
  currency: String!
  status: ProductStatus!
}

enum ProductStatus { UNSPECIFIED ACTIVE ARCHIVED }

type Cart {
  customerId: ID!
  lines: [CartLine!]!
}

type CartLine {
  productId: ID!
  quantity: Int!
}

input CartLineInput {
  productId: ID!
  quantity: Int!
}

input OrderLineInput {
  productId: ID!
  quantity: Int!
}

type OrderConnection {
  orders: [Order!]!
  nextPageToken: String
}

type Order {
  id: ID!
  customerId: ID!
  status: OrderStatus!
  totalMinor: Int!
  currency: String!
  createdAt: String!
}

enum OrderStatus { UNSPECIFIED PENDING CONFIRMED CANCELLED }
